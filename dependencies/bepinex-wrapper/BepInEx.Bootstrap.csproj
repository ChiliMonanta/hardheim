<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>1.0.0.0</Version>
    <SourcePath>$(MSBuildThisFileDirectory)..\BepInEx\BepInEx.Bootstrap</SourcePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourcePath)\**\*.cs" Exclude="$(SourcePath)\bin\**;$(SourcePath)\obj\**" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)BepInEx.csproj" Private="false" IncludeAssets="compile" />
  </ItemGroup>
</Project>
